    <ol class="breadcrumb" aria-label="Breadcrumb">
        {#
        <li>
            <div>Marius <span>.&nbsp;Home page</span></div>
        </li>
        #}
        {% if record.document_id != 0 %}
        <li>
            <a href="/">Home</a>
        </li>
        <li>
            <a href="/articles">Articles</a>
        </li>
        <li>
            <div>{% block breadcrumb_current_item %}{% endblock %}</div>
        </li>
        {% endif %}
    </ol>
</nav>
