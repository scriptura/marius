            </a>
            {% endif %}
        </li>
        <li>
            {% if record.document_id == 6 %}
            <div class="current">
                <svg class="icon-inline" aria-hidden="true">
                    <use href="{% asset sprites/utils.svg %}#border-none"></use>
                </svg>
                Content 6
            </div>
            {% else %}
            <a href="/content/6">
                <svg class="icon-inline" aria-hidden="true">
                    <use href="{% asset sprites/utils.svg %}#border-none"></use>
                </svg>
                Content 6
            </a>
            {% endif %}
        </li>
        <li>
