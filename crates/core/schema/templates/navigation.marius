{% block main_nav %}
<a class="sr-only" href="#main">Aller au contenu</a>
<nav id="nav" class="nav" role="navigation">
    <a class="logo-nav" href="/">
        <span class="sr-only">Scriptura</span>
    </a>
    {#
    <div class="logo-nav">
        <span class="sr-only">Marius</span>
    </div>
    #}
    <button id="cmd-nav" class="cmd-nav" type="button" aria-label="Main Menu" popovertarget="sub-nav"
        popovertargetaction="toggle">
        <svg viewBox="0 0 100 100" aria-hidden="true">
            <rect x="5" y="20" width="90" height="6"></rect>
            <rect x="5" y="47" width="90" height="6"></rect>
            <rect x="5" y="74" width="90" height="6"></rect>
        </svg>
    </button>
    <ul class="sub-nav" id="sub-nav" aria-labelledby="cmd-nav" popover>
        <li><a href="/content/1"><svg class="icon-inline" aria-hidden="true">
                    <use href="{% asset sprites/utils.svg %}#ampersand"></use>
                </svg>Content 1</a></li>
        <li><a href="/content/2"><svg class="icon-inline" aria-hidden="true">
                    <use href="{% asset sprites/utils.svg %}#border-none"></use>
                </svg>Content 2</a></li>
        <li><a href="/content/3"><svg class="icon-inline" aria-hidden="true">
                    <use href="{% asset sprites/utils.svg %}#border-none"></use>
                </svg>Content 3</a></li>
        <li><a href="/content/4"><svg class="icon-inline" aria-hidden="true">
                    <use href="{% asset sprites/utils.svg %}#border-none"></use>
                </svg>Content 4</a></li>
        <li><a href="/content/5"><svg class="icon-inline" aria-hidden="true">
                    <use href="{% asset sprites/utils.svg %}#border-none"></use>
                </svg>Content 5</a></li>
        <li><a href="/content/6"><svg class="icon-inline" aria-hidden="true">
                    <use href="{% asset sprites/utils.svg %}#border-none"></use>
                </svg>Content 6</a></li>
        <li><a href="/content/10"><svg class="icon-inline" aria-hidden="true">
                    <use href="{% asset sprites/utils.svg %}#border-none"></use>
                </svg>Content 10</a></li>
        <li><a href="/content/14"><svg class="icon-inline" aria-hidden="true">
                    <use href="{% asset sprites/utils.svg %}#border-none"></use>
