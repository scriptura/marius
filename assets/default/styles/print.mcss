@charset "utf-8";
/* Les guillemets doubles évitent une erreur au validateur du W3C. @see https://validator.w3.org/ */

/* DÉCLARATION DE L'INDEX DE LA CASCADE (Ordre de priorité croissant) */
@layer tokens, base, layout, transitions, components, helpers, print;

/* 1. COUCHE TOKENS (Variables de Runtime & Déclarations de ressources) */
/* Ingestion globale (Hors-couche pour résolution globale par l'AST) */
@import "media.mcss";
@import "variable.mcss";
@import "font.mcss" layer(tokens);

/* 2. COUCHE BASE (Règles génériques et sémantique brute) */
@import "base.mcss" layer(base);
@import "typography.mcss" layer(base);

/* 3. COUCHE LAYOUT (Invariants structurels et systèmes de grilles) */
/* @import 'layout.mcss' layer(layout); */
@import "grid.mcss" layer(layout);
@import "column.mcss" layer(layout);

/* 4. COUCHE TRANSITIONS (Animations et transitions) */
@import "transition.mcss" layer(transitions);

/* 5. COUCHE COMPONENTS (Logique modulaire et blocs atomiques) */
/* @import 'navigation.mcss' layer(components);
@import 'breadcrumb.mcss' layer(components);
@import 'alert.mcss' layer(components); */
@import "list.mcss" layer(components);
@import "image.mcss" layer(components);
/* @import 'imageAnimation.mcss' layer(components);
@import 'mediaPlayer.mcss' layer(components);
@import 'map.mcss' layer(components);
@import 'card.mcss' layer(components);
@import 'flip.mcss' layer(components); */
@import "codeBlock.mcss" layer(components);
@import "messageBox.mcss" layer(components);
@import "table.mcss" layer(components);
/* @import 'form.mcss' layer(components);
@import 'input.mcss' layer(components);
@import 'checkbox.mcss' layer(components);
@import 'range.mcss' layer(components);
@import 'button.mcss' layer(components);
@import 'accordion.mcss' layer(components);
@import 'tab.mcss' layer(components);
@import 'scrollTop.mcss' layer(components); */
@import "footer.mcss" layer(components);
@import "article.mcss" layer(components);
@import "dropCap.mcss" layer(components);
/* @import 'lineMark.mcss' layer(components);
@import 'calendar.mcss' layer(components);
@import 'progress.mcss' layer(components);
@import 'loader.mcss' layer(components); */
@import "chart.mcss" layer(components);
/* @import 'scrollBar.mcss' layer(components); */
@import "ribbon.mcss" layer(components);
/* @import 'forum.mcss' layer(components);
@import 'skin.mcss' layer(components);
@import 'demo.mcss' layer(components); */

/* 6. COUCHE HELPERS (Surcharges de commodité / Utilitaires) */
/* @note Les helpers s'appliquent à la fin dans le but d'écraser des styles tels que font-size. */
@import "helper.mcss" layer(helpers);

@layer print {
  body > :not(main, footer),
  form,
  fieldset,
  /* input, */
  /* textarea, */
  button,
  audio,
  video,
  [class*=player],
  /* .map, */
  .accordion,
  .card,
  pre button,
  pre div,
  .line-mark {
    display: none !important;
  }

  * {
    text-shadow: none !important;
  }

  *,
  ::before,
  ::after {
    color: black !important;
  }

  body,
  .article {
    display: block; /* @affected Firefox */
  }

  .footer {
    width: 100vw;
    box-shadow: none;
    & > * {
      flex-direction: column;
    }
  } /* @note Harmonisation entre navigateurs. */

  pre,
  blockquote,
  tr,
  img,
  figure,
  [class*="figure"] {
    break-inside: avoid;
  }

  p,
  h2,
  h3 {
    orphans: 3;
    widows: 3;
  }

  h2,
  h3 {
    break-after: avoid;
  }

  a,
  h1 span {
    color: tomato !important;
  }

  [class*="figure"] {
    box-shadow: none !important;
    border: 0.1em solid #ddd; /* @affected Firefox @note Pas de prise en compte de la bordure si 1px. */
  }

  [class*="-alignleft"] {
    float: left;
    margin-inline-end: var(--gap);
  }

  [class*="-alignright"] {
    float: right;
    margin-inline-start: var(--gap);
  }

  .article .wrapper {
    text-align: justify;
    margin-block-start: var(--gap);
    padding: 0 !important; /* @affected Firefox */
    box-shadow: none !important; /* @affected Firefox */
  }

  .tags a {
    background: #efefef !important;
  }

  .avatar,
  .avatars,
  .tags {
    print-color-adjust: exact !important;
  }

  html,
  footer {
    background: white;
  }
}
