/* Dictionnaire des macros de configuration globale (media queries level 5) */

/* @custom-media est intéressant à terme, mais non encore supporté par les navigateurs,
 * et de toute façon non supporté par @container, uniquement par @media. */

/* Vecteurs ascendants (Mobile First) */
/*
@custom-media --from-xs (width > 35em);
@custom-media --from-s (width > 50em);
@custom-media --from-m (width > 70em);
@custom-media --from-l (width > 92em);
@custom-media --from-nav (width > 97em);
*/

/* Vecteurs descendents (Surcharges ciblées) */
/*
@custom-media --to-xs (width <= 35em);
@custom-media --to-s (width <= 50em);
@custom-media --to-m (width <= 70em);
@custom-media --to-l (width <= 92em);
@custom-media --to-nav (width <= 97em);
*/

/* Segments (Intervalles stricts) */
/*
@custom-media --from-xs-to-s (35em < width <= 50em);
@custom-media --from-s-to-m (50em < width <= 70em);
@custom-media --from-m-to-l (70 < width <= 92em);

@custom-media --from-s-to-nav (50 < width <=97em);
*/

/* Variables MCSS */
$from-xs: (width > 35em);
$from-s: (width > 50em);
$from-m: (width > 70em);
$from-l: (width > 92em);
$from-nav: (width > 97em);

/* Vecteurs descendents (Surcharges ciblées) */
$to-xs: (width <= 35em);
$to-s: (width <= 50em);
$to-m: (width <= 70em);
$to-l: (width <= 92em);
$to-nav: (width <= 97em);

/* Segments (Intervalles stricts) */
$from-xs-to-s: (35em < width <= 50em);
$from-s-to-m: (50em < width <= 70em);
$from-m-to-l: (70 < width <= 92em);

$from-s-to-nav: (50 < width <=97em);
