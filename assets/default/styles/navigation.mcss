/**
 * @architecture Navigation Hybride — Strategy Pattern CSS/JS
 * @summary Fallback déclaratif (Popover API) + Amélioration progressive (JS Pipeline)
 *
 * 1. MODÈLE HYBRIDE & AMÉLIORATION PROGRESSIVE
 *    - Fallback (Zero-JS) : Utilisation des attributs natifs `popover` et `popovertarget`.
 *      La navigation s'appuie entièrement sur le mécanisme de Top Layer du navigateur.
 *    - Runtime (JS disponible) : L'initialisation JavaScript retire de manière synchrone les
 *      attributs popover (`removeAttribute`) pour basculer vers un pipeline de contrôle enrichi :
 *      animations matricielles séquencées, gestion dynamique de l'état `inert` du DOM, et 
 *      gestion explicite de l'accessibilité (`aria-expanded`, `aria-hidden`).
 *
 * 2. BYPASS DES TRANSFORMATIONS SPATIALES (:popover-open)
 *    - En mode fallback, les animations JS basées sur les classes `.active` et la translation
 *      hors-champ (`transform: translateX(-110vw)`) sont inactives.
 *    - Le pseudo-moteur CSS intercepte l'état matériel `:popover-open` pour imposer une
 *      réinitialisation géométrique immédiate (`transform: none` sur `.sub-nav` et ses enfants `li`),
 *      garantissant l'affichage instantané des éléments sans calculs de transition.
 *
 * 3. ISOLATION TOP-LAYER ET OMBRE VECTORIELLE DESCENDANTE
 *    - Le comportement par défaut du Top Layer (`::backdrop`) obscurcit l'intégralité du viewport,
 *      masquant le bouton de commande `.cmd-nav` situé dans la barre supérieure ($Y = 3\text{em}$).
 *    - Arbitrage : Le `::backdrop` natif est rendu totalement transparent (`background: transparent`).
 *    - L'assombrissement du contenu inférieur est réimplanté via une projection vectorielle
 *      descendante (`box-shadow: 0 100vh 0 100vh var(--colorAB7)`) ancrée sur le bord inférieur de
 *      `.sub-nav`. Cela conserve l'icône de fermeture/hamburger totalement visible et interactive.
 */

.nav {
  position: relative;
  /* @note Permet de passer au-dessus du pseudo élément de body (ce dernier faisant un effet d'ombrage sur le contenu en version mobile) et aussi de certains éléments définis par des sources externes (comme les Maps Leaflet). */
  z-index: 2000;
  display: grid;
  user-select: none;
  background-color: var(--colorG15);

  @media ($to-nav) {
    grid-template-rows: 3em;
    grid-template-columns: 3em minmax(0, 1fr) 3em;
    grid-template-areas: "logo breadcrumb cmd";
  }

  @media ($from-nav) {
    grid-template-rows: repeat(2, 2.5em);
    grid-template-columns: 5em minmax(0, 1fr);
    grid-template-areas: "logo subnav" "logo breadcrumb";
  }

  & .avatar {
    display: inline-block;
    vertical-align: -0.5em;
    width: 1.7em;
    aspect-ratio: 1;
    margin-inline-end: 0.5em;
    background-color: var(--colorG27);
    background-image: var(--img, "");
    background-size: cover;
    border-radius: 50%;
  }
}

.logo-nav {
  grid-area: logo;
  display: block;
  box-shadow: 0.5rem 0.5rem 0.5rem var(--colorAB2);
  background-color: var(--color2);

  &::after {
    content: "";
    display: block;
    width: 100%;
    height: 100%;
    background-image: url("../images/logo.svg");
    background-repeat: no-repeat;
    background-position: 50% 50%;
    background-size: auto 70%;
    filter: brightness(1.25) contrast(1.25);
  }

  a&:where(:focus-within, :hover) {
    background-color: var(--color5);

    &::after {
      animation: anim-logo 0.5s ease-in-out;
    }
  }
}

.service-unavailable .logo-nav {
  background-image: repeating-linear-gradient(
    45deg,
    transparent,
    transparent 5px,
    hsla(0, 100%, 0%, 0.25) 5px,
    hsla(0, 100%, 0%, 0.25) 10px
  ); /* @note Hachures non scalables. */
}

.offline .logo-nav {
  background-color: var(--color6);
}

@keyframes anim-logo {
  30% {
    transform: rotate(-30deg);
  }
}

.sub-nav {
  /* Reset en raison de popover */
  position: relative;
  border: none;
  margin: 0;
  padding: 0;
  background-color: transparent;

  grid-area: subnav;
  box-shadow: 0.5rem 0.5rem 0.5rem var(--colorAB2);
  display: flex;
  width: 100%;
  margin: 0;
  padding: 0;

  &:popover-open {
    position: absolute;
    /* Le navigateur applique un display: block au popover par défaut. 
       On maintient le modèle flex. */
    display: flex;
    /* On court-circuite le hors-champ translateX(-110vw) de $to-nav */
    transform: none;

    &::backdrop {
      background: transparent;
    }

    /* 2. Projection descendante : Offset_Y = 100vh, Spread = 100vh */
    box-shadow: 0 100vh 0 100vh var(--colorAB7);

  }

  & .current {
    background-color: var(--color2);

    @media ($from-nav) {
      position: relative;
      /* @note La valeur doit être suffisante pour passer au-dessus des items de ".breadcrumb." */
      z-index: 10;

      &::after {
        content: "";
        position: absolute;
        top: 100%;
        left: calc(50% - 1em);
        width: 2em;
        height: 1em;
        background-color: var(--color2);
        clip-path: polygon(0 0, 100% 0, 50% 100%);
      }
    }
  }

  @media ($from-nav) {
    & > :last-child {
      margin-inline-start: auto;
    }
  }

  @media ($to-nav) {
    position: absolute;
    z-index: 800;
    top: 3em;
    left: 0;
    width: 100vw;
    flex-wrap: wrap;
    transform: translateX(-110vw);
  }

  & li {
    list-style: none;
    @media ($to-nav) {
      flex: 1;
      flex-basis: 50%;
      background-color: var(--colorG15);
      /* transform: rotate(90deg); */
      /* @todo En test pour les performances. */
      transform: rotate(90deg) translateZ(0);

      @media (prefers-reduced-motion: no-preference) {
        transition: transform 0.4s ease-in-out;
      }

      .active & {
        /* @note L'utilisation des pourcentages provoque un effet de bord avec overflow:clip sur le body ; à éviter. Valeur au-delà de 100vw afin de cacher les ombres des boîtes. */
        transform: translateX(110vw) rotate(0deg);
      }
      @for $i from 1 to 12 {
        &:nth-child($i) {
          transition-delay: calc($i * 0.05s);
        }
      }
      /* Reset immédiat du pipeline de transformation sur les enfants */
      .sub-nav:popover-open & {
        transform: none;
        transition: none;
      }
    }

    @media ($from-xs-to-s) {
      flex-basis: 33%;
    }

    @media ($from-s-to-nav) {
      flex-basis: 25%;
    }

    & > * {
      display: block;
      white-space: nowrap;
      padding: 0 1em;
      box-shadow: inset 0.5rem 0.5rem 0.5rem var(--colorAB2);

      @media ($to-nav) {
        line-height: 3;
      }

      @media ($from-nav) {
        line-height: 2.5;
      }

      &.current {
        color: var(--colorW);
      }
    }
  }

  & a {
    overflow: hidden;
    /* white-space: nowrap; */
    text-overflow: ellipsis;
    /* color: var(--colorT2); */
    text-decoration: none;

    &:where(:focus, :hover, .active) {
      /* color: var(--colorW); */
      background-color: var(--color2);

      & svg {
        animation: anim-jump 0.5s ease-in-out;
      }
    }
  }
}

@media ($to-nav) {
  :where(html, body).active {
    overflow: clip;
  }

  body.active {
    &::before {
      content: "";
      position: absolute;
      z-index: 1;
      inset: 0;
      background-color: var(--colorAB7);
    }

    & :where(main, footer, aside) {
      user-select: none;
      pointer-events: none;
      filter: blur(2px) grayscale(1);
    }
  }
}

@media ($from-nav) {
  @keyframes anim-jump {
    30% {
      transform: translateY(-0.3em);
    }
  }
}

.cmd-nav {
  all: unset;
  grid-area: cmd;

  @media ($from-nav) { /* Par défaut le bouton est géré par le navigateur avec l'attribut popover, donc on garde le bouton, plus besoin de (scripting: none) */
    display: none;
  }

  @media ($to-nav) {
    padding: 0.5em;
    background-color: var(--colorG15);
    transition: background-color 0.3s;
    cursor: pointer;

    & rect {
      transform-origin: center;
      fill: var(--colorT);
      @media (prefers-reduced-motion: no-preference) {
        transition: all 0.2s cubic-bezier(0.55, -0.65, 0, 2.32); /* ease-in-out */
      }
    }

    &:not(:focus-visible, :hover, [aria-expanded="true"]) {
      & svg {
        border-radius: 50%;
        background-color: var(--color2);
      }

      & rect {
        x: 45px;
        width: 10px;
      }
    }

    &:where(:focus-visible, :hover) {
      background-color: var(--color2);
    }

    &[aria-expanded="true"] svg {
      & :nth-child(1) {
        y: 47px;
        transform: rotate(45deg);
      }

      & :nth-child(2) {
        transform: rotate(-45deg);
      }

      & :nth-child(3) {
        y: 47px;
        transform: rotate(-45deg);
      }
    }
  }
}
