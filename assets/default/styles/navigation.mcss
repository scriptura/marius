/* ==========================================================================
   NAVIGATION PIPELINE
   Paradigme : Déclaratif, Zéro-JS, Native State Machine (Popover API)
   ========================================================================== */

.nav {
  position: relative;
  /* [LAYOUT] : Assure l'empilement au-dessus des contextes locaux générés par des librairies tierces (ex: Leaflet). */
  z-index: 2000;
  display: grid;
  user-select: none;
  background-color: var(--colorG15);

  @media ($to-nav) {
    grid-template-rows: 3em;
    grid-template-columns: 3em minmax(0, 1fr) 3em;
    grid-template-areas: "logo breadcrumb cmd";
  }

  @media ($from-nav) {
    grid-template-rows: repeat(2, 2.5em);
    grid-template-columns: 5em minmax(0, 1fr);
    grid-template-areas: "logo subnav" "logo breadcrumb";
  }

  & .avatar {
    display: inline-block;
    vertical-align: -0.5em;
    width: 1.7em;
    aspect-ratio: 1;
    margin-inline-end: 0.5em;
    background-color: var(--colorG27);
    background-image: var(--img, "");
    background-size: cover;
    border-radius: 50%;
  }
}

.logo-nav {
  grid-area: logo;
  display: block;
  box-shadow: 0.5rem 0.5rem 0.5rem var(--colorAB2);
  background-color: var(--color2);

  &::after {
    content: "";
    display: block;
    width: 100%;
    height: 100%;
    background-image: url("../images/logo.svg");
    background-repeat: no-repeat;
    background-position: 50% 50%;
    background-size: auto 70%;
    filter: brightness(1.25) contrast(1.25);
  }

  a&:where(:focus-within, :hover) {
    background-color: var(--color5);

    &::after {
      animation: anim-logo 0.5s ease-in-out;
    }
  }
}

.service-unavailable .logo-nav {
  background-image: repeating-linear-gradient(
    45deg,
    transparent,
    transparent 5px,
    hsla(0, 100%, 0%, 0.25) 5px,
    hsla(0, 100%, 0%, 0.25) 10px
  );
}

.offline .logo-nav {
  background-color: var(--color6);
}

@keyframes anim-logo {
  30% {
    transform: rotate(-30deg);
  }
}

/* --------------------------------------------------------------------------
   [STATE MACHINE] : .sub-nav
   Délégation de l'état ouvert/fermé au moteur C++ via l'attribut HTML 'popover'.
   Le CSS agit uniquement comme une fonction pure : Etat(C++) -> Rendu(GPU).
   -------------------------------------------------------------------------- */
.sub-nav {
  /* [RESET DÉTERMINISTE] : On écrase sélectivement les styles UA du popover 
     sans utiliser 'all: unset;' pour préserver le 'display: none' critique au culling. */
  border: none;
  margin: 0;
  padding: 0;
  background-color: transparent;

  grid-area: subnav;
  box-shadow: 0.5rem 0.5rem 0.5rem var(--colorAB2);
  width: 100%;

  @media ($from-nav) {
    /* [DESKTOP OVERRIDE] : Écrase le comportement popover sur grand écran.
       L'élément réintègre le flux Grid ('static' annule le 'fixed' UA). */
    display: flex;
    position: static;
  }

  & .current {
    background-color: var(--color2);

    @media ($from-nav) {
      position: relative;
      z-index: 10;

      &::after {
        content: "";
        position: absolute;
        top: 100%;
        left: calc(50% - 1em);
        width: 2em;
        height: 1em;
        background-color: var(--color2);
        clip-path: polygon(0 0, 100% 0, 50% 100%);
      }
    }
  }

  @media ($from-nav) {
    & > :last-child {
      margin-inline-start: auto;
    }
  }

  @media ($to-nav) {
    /* [TOP-LAYER ANCHORING] : Repositionnement explicite dans le viewport (Mobile). */
    position: fixed;
    top: 3em;
    left: 0;
    width: 100vw;
    flex-wrap: wrap;
    
    /* [SYNCHRONISATION PIPELINE] : 'allow-discrete' retarde l'application de 
       'display: none' par le C++ jusqu'à l'exécution complète de la plus longue
       transition enfant (Delay 0.6s + Duration 0.4s = 1s max). */
    transition: display 1s allow-discrete, overlay 1s allow-discrete;

    &:popover-open {
      /* Modification isolée du modèle de boîte, conditionnée à l'état actif. */
      display: flex;
    }

    /* [GPU ACCELERATION] : Le ::backdrop natif remplace la mutation du DOM 
       (anciennement body.active::before). Le filtrage est déporté sur le thread GPU. */
    &::backdrop {
      background-color: var(--colorAB7);
      backdrop-filter: blur(2px) grayscale(1);
      opacity: 0;
      transition: opacity 0.4s, display 1s allow-discrete, overlay 1s allow-discrete;
    }

    &:popover-open::backdrop {
      opacity: 1;
    }

    @starting-style {
      &:popover-open::backdrop {
        opacity: 0;
      }
    }
  }

  & li {
    list-style: none;
    
    @media ($to-nav) {
      flex: 1;
      flex-basis: 50%;
      background-color: var(--colorG15);
      
      /* [TRANSFORM FLATTENING] : Application des matrices de transformation 
         uniquement sur les nœuds feuilles. Évite au compositeur de calculer 
         des matrices combinées (Parent * Enfant) à chaque frame. */
      transform: translateX(-110vw) rotate(90deg) translateZ(0);

      @media (prefers-reduced-motion: no-preference) {
        transition: transform 0.4s ease-in-out;
      }

      @for $i from 1 to 12 {
        &:nth-child($i) {
          transition-delay: calc($i * 0.05s);
        }
      }

      /* Sélecteur descendant basé sur l'état parent (C++ géré) */
      .sub-nav:popover-open & {
        transform: translateX(0) rotate(0deg) translateZ(0);
      }
    }

    @media ($from-xs-to-s) {
      flex-basis: 33%;
    }

    @media ($from-s-to-nav) {
      flex-basis: 25%;
    }

    & > * {
      display: block;
      white-space: nowrap;
      padding: 0 1em;
      box-shadow: inset 0.5rem 0.5rem 0.5rem var(--colorAB2);

      @media ($to-nav) {
        line-height: 3;
      }

      @media ($from-nav) {
        line-height: 2.5;
      }

      &.current {
        color: var(--colorW);
      }
    }
  }

  & a {
    overflow: hidden;
    text-overflow: ellipsis;
    text-decoration: none;

    &:where(:focus, :hover, .active) {
      background-color: var(--color2);

      & svg {
        animation: anim-jump 0.5s ease-in-out;
      }
    }
  }
}

/* [DATA LAYOUT INITIALIZATION] : Injection de la "Frame 0" dans le pipeline
   de rendu lors de la promotion du composant depuis 'display: none'. */
@starting-style {
  @media ($to-nav) {
    .sub-nav:popover-open li {
      transform: translateX(-110vw) rotate(90deg) translateZ(0);
    }
  }
}

@media ($from-nav) {
  @keyframes anim-jump {
    30% {
      transform: translateY(-0.3em);
    }
  }
}

/* --------------------------------------------------------------------------
   [UI CONTROLLER] : .cmd-nav
   Le déclencheur ne stocke aucun état. Son apparence est purement dérivée 
   de l'état de la cible via la pseudo-classe relationnelle :has().
   -------------------------------------------------------------------------- */
.cmd-nav {
  all: unset;
  grid-area: cmd;

  @media (scripting: none), ($from-nav) {
    display: none;
  }

  @media ($to-nav) {
    padding: 0.5em;
    background-color: var(--colorG15);
    transition: background-color 0.3s;
    cursor: pointer;

    & rect {
      transform-origin: center;
      fill: var(--colorT);
      @media (prefers-reduced-motion: no-preference) {
        transition: all 0.2s cubic-bezier(0.55, -0.65, 0, 2.32);
      }
    }

    /* Évaluation réactive : S'applique SI le sibling #sub-nav n'est PAS ouvert. */
    &:not(:focus-visible, :hover):not(:has(~ #sub-nav:popover-open)) {
      & svg {
        border-radius: 50%;
        background-color: var(--color2);
      }

      & rect {
        x: 45px;
        width: 10px;
      }
    }

    &:where(:focus-visible, :hover) {
      background-color: var(--color2);
    }

    /* Évaluation réactive : S'applique SI le sibling #sub-nav EST ouvert. */
    &:has(~ #sub-nav:popover-open) svg {
      & :nth-child(1) {
        y: 47px;
        transform: rotate(45deg);
      }

      & :nth-child(2) {
        transform: rotate(-45deg);
      }

      & :nth-child(3) {
        y: 47px;
        transform: rotate(-45deg);
      }
    }
  }
}

/* [VIEWPORT LOCK] : Couplage fort entre le scroll root et la machine d'état. */
@media ($to-nav) {
  body:has(#sub-nav:popover-open) {
    overflow: clip;
  }
}
